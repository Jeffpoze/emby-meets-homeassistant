{
  "name": "emby-meets-homeassistant",
  "version": "0.1.0",
  "description": "A Home Assistant Lovelace card for browsing and casting Emby libraries.",
  "type": "module",
  "scripts": {
    "build": "npm run lint && rollup -c",
    "watch": "rollup -c -w",
    "dev": "npm run build && cp dist/emby-meets-homeassistant.js ~/.homeassistant/www/emby-meets-homeassistant.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "home-assistant-js-websocket": "^9.4.0",
    "prettier": "^3.3.3",
    "rollup": "^4.27.4",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
